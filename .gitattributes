# Auto-detect text files and perform LF normalization
* text=auto

# Flutter/Dart files should use LF
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Windows files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
